# Copy to backend/.env and fill in. Never commit the real .env.
# EMAIL_PASS must be a Gmail App Password: https://myaccount.google.com/apppasswords
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-16-char-app-password
# Optional: deliver to a different inbox than EMAIL_USER
CONTACT_TO=
PORT=5000
# Optional, if hosting this Express server separately: your live site origin(s), comma-separated
ALLOWED_ORIGINS=
