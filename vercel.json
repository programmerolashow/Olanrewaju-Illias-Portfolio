{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/admin/:action(login|logout|session)", "destination": "/api/admin/auth?action=:action" },
    { "source": "/updates/:id", "destination": "/api/share/update?id=:id" },
    { "source": "/v2/updates/:id", "destination": "/api/share/update?id=:id&design=v2" },
    { "source": "/((?!api/).*)", "destination": "/" }
  ]
}
